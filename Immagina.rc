    EDITTEXT        IDC_IMPORT_TOLERANCE,82,26,43,14,ES_AUTOHSCROLL
    LTEXT           "Color Limit",IDC_STATIC,17,12,34,8
    LTEXT           "Threshold",IDC_STATIC,19,29,32,8
END

