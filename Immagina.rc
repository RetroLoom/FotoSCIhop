IDD_IMPORT_IMAGE DIALOGEX 0, 0, 141, 79
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dialog"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,16,53,35,14
    PUSHBUTTON      "Cancel",IDCANCEL,82,53,43,14
