/////////////////////////////////////////////////////////////////////////////
// English (United States) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_IMMAGINA            ICON                    "Paint.ico"

IDI_SMALL               ICON                    "smpaint.ico"

AICON                   ICON                    "Paint.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_IMMAGINA MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O",            ID_CARICA
        MENUITEM "Next File\tCtrl+N",           ID_FILE_NEXTFILE
        MENUITEM "Open V56 from Volume...",     ID_CARICAV56VOL
        MENUITEM "Open P56 from Volume...",     ID_CARICAP56VOL
        MENUITEM "&Save",                       ID_SALVA
        MENUITEM "S&ave as...\tCtrl+S",         ID_SALVACOME
        MENUITEM SEPARATOR
        MENUITEM "Preferences",                 IDM_PREFERENCES
        MENUITEM "&Quit\tCtrl+Q",               IDM_EXIT
    END
    POPUP "&Image"
    BEGIN
        MENUITEM "Show Table\tCtrl+T",          ID_PALETTE, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Import Image...\tCtrl+I",    ID_IMPORTABMP
        MENUITEM "&Export Image...\tCtrl+E",    ID_ESPORTABMP
        MENUITEM SEPARATOR
        MENUITEM "Import Palette...",           ID_COLORI_IMPORTACOLORI
        MENUITEM "Export Palette...",           ID_COLORI_ESPORTACOLORI
        MENUITEM SEPARATOR
        MENUITEM "Realmpal Import",             IDM_REALMPAL_IMPORT
        MENUITEM "Palette Manager",             IDM_PALETTE_MANAGER
        MENUITEM "Clut Generator",              IDM_CLUTGEN
        MENUITEM "&Properties...\tCtrl+P",      IDM_PROPERTIES
        MENUITEM SEPARATOR
        MENUITEM "Show Priority Bars",          ID_PRIORITYBARS
        MENUITEM SEPARATOR
        MENUITEM "Zoom In\t+",                  ID_ZOOM_IN
        MENUITEM "Zoom Out\t-",                 ID_ZOOM_OUT
        MENUITEM "Zoom Reset\tCtrl+0",          ID_ZOOM_RESET
    END
    POPUP "&Go"
    BEGIN
        MENUITEM "&Previous Cell\tCtrl + <-",   ID_CELLAPRECEDENTE, GRAYED
        MENUITEM "&Next Cell\tCtrl + ->",       ID_CELLASUCCESSIVA, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "P&revious Loop\tCtrl + UpArrow", ID_CICLOPRECEDENTE, GRAYED
        MENUITEM "N&ext Loop\tCtrl + DownArrow", ID_CICLOSUCCESSIVO, GRAYED
    END
    POPUP "?"
    BEGIN
        MENUITEM "&TraduSCI Manual...",         IDM_MANUAL
        MENUITEM SEPARATOR
        MENUITEM "&About...",                   IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_IMMAGINA ACCELERATORS
BEGIN
    "O",            ID_CARICA,              VIRTKEY, CONTROL, NOINVERT
    VK_LEFT,        ID_CELLAPRECEDENTE,     VIRTKEY, CONTROL, NOINVERT
    VK_RIGHT,       ID_CELLASUCCESSIVA,     VIRTKEY, CONTROL, NOINVERT
    VK_UP,          ID_CICLOPRECEDENTE,     VIRTKEY, CONTROL, NOINVERT
    VK_DOWN,        ID_CICLOSUCCESSIVO,     VIRTKEY, CONTROL, NOINVERT
    "E",            ID_ESPORTABMP,          VIRTKEY, CONTROL, NOINVERT
    "I",            ID_IMPORTABMP,          VIRTKEY, CONTROL, NOINVERT
    "S",            ID_SALVACOME,           VIRTKEY, CONTROL, NOINVERT
    "Q",            IDM_EXIT,               VIRTKEY, CONTROL, NOINVERT
    "N",            ID_FILE_NEXTFILE,       VIRTKEY, CONTROL, NOINVERT
    "P",            IDM_PROPERTIES,         VIRTKEY, CONTROL, NOINVERT
    "T",            ID_PALETTE,             VIRTKEY, CONTROL, NOINVERT
    "R",            IDM_REFERENCE,          VIRTKEY, CONTROL, NOINVERT
    VK_OEM_PLUS,    ID_ZOOM_IN,             VIRTKEY, NOINVERT
    VK_OEM_MINUS,   ID_ZOOM_OUT,            VIRTKEY, NOINVERT
    "0",            ID_ZOOM_RESET,          VIRTKEY, CONTROL, NOINVERT
END

#endif    // English (United States) resources
